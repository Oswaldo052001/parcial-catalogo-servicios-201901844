{
  "name": "parcial-catalogo-servicios-201901844",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestión del catálogo de servicios de TI - Parcial práctico Software Avanzado USAC",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "importar": "node scripts/importar.js",
    "seed:demo": "node scripts/seed-demo.js",
    "cuentas": "node scripts/crear-cuentas.js",
    "setup": "node src/db/migrate.js && node scripts/importar.js && node scripts/seed-demo.js && node scripts/crear-cuentas.js",
    "calidad": "node scripts/calidad.js",
    "test": "jest --runInBand",
    "check": "node scripts/calidad.js && jest --runInBand"
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "./tests/global-setup.js",
    "setupFiles": [
      "./tests/setup-env.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
