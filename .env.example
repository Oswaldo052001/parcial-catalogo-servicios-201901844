# Copie este archivo como .env (cp .env.example .env) y ajuste los valores si lo desea.
# TODOS los valores son de DEMOSTRACIÓN. No coloque aquí secretos reales; .env está excluido de Git.

# Puerto del host donde se publica la aplicación: http://localhost:8080
APP_PORT=8080

# Base de datos PostgreSQL (solo accesible dentro de la red de Docker)
POSTGRES_USER=catalogo
POSTGRES_PASSWORD=catalogo_local
POSTGRES_DB=catalogo

# true: al arrancar migra, importa el Excel, carga datos de demostración y crea las cuentas de evaluación.
AUTO_SETUP=true
SESSION_HOURS=8

# Cuentas de evaluación (una por rol). Se crean o restablecen con: docker compose exec app npm run cuentas
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@catalogo.local
ADMIN_PASSWORD=Admin#2026
CONSULTA_USUARIO=consulta
CONSULTA_CORREO=consulta@catalogo.local
CONSULTA_PASSWORD=Consulta#2026
